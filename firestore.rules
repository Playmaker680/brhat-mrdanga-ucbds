rules_version = '2';

// Bṛhat Mṛdaṅga Database: only Google accounts listed in /members can read or write anything.
// Each member document's ID is the person's Google email in lowercase, e.g. members/radha@gmail.com
// A member with { admin: true } can add and remove people from that list.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(myEmail()));
    }
    function isAdmin() {
      return isMember() && get(/databases/$(database)/documents/members/$(myEmail())).data.admin == true;
    }

    // The access list. Anyone signed in may check their own entry; members see the list; only admins change it.
    match /members/{email} {
      allow read: if signedIn() && (email == myEmail() || isMember());
      allow write: if isAdmin();
    }

    // Everything else (people, meetings, notes, progress, team, config): members only.
    match /{coll}/{docId} {
      allow read, write: if coll != "members" && isMember();
    }
  }
}
